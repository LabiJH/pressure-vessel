# .env.example
# Copy this to .env and edit as needed. .env is gitignored, never commit
# your actual values. If no .env exists, the defaults below are used.

# Which interface Prometheus/Grafana bind to.
# Default 0.0.0.0 = reachable from anywhere. Scope this to a private/VPN
# interface (e.g. your VPS's internal IP) if this box has a public IP.
BIND_ADDR=0.0.0.0

# Grafana's initial admin password. The default "admin"/"admin" is public
# knowledge, change this if Grafana will be reachable outside your LAN.
GF_SECURITY_ADMIN_PASSWORD=admin
